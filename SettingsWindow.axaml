<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="UbeliskUI.SettingsWindow"
        Title="Ubelisk Settings"
        Width="800" Height="550"
        Background="#0A0A0F"
        WindowStartupLocation="CenterOwner">

  <Grid ColumnDefinitions="200,*">

    <Border Grid.Column="0" Background="#111118">
      <StackPanel Margin="10">
        <TextBlock Text="SETTINGS" Foreground="#555555"
                   FontSize="11" Margin="10,15,0,10"/>
        <Button x:Name="InterfaceBtn" Content="Interface"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left"
                Background="#0064DC" Foreground="White"
                Margin="5,2" Padding="12,8" CornerRadius="8"
                Click="InterfaceBtn_Click"/>
        <Button x:Name="GpuBtn" Content="GPU"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left"
                Background="Transparent" Foreground="White"
                Margin="5,2" Padding="12,8" CornerRadius="8"
                Click="GpuBtn_Click"/>
        <Button x:Name="CpuBtn" Content="CPU"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left"
                Background="Transparent" Foreground="White"
                Margin="5,2" Padding="12,8" CornerRadius="8"
                Click="CpuBtn_Click"/>
        <Button x:Name="EmulatorBtn" Content="Emulator"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left"
                Background="Transparent" Foreground="White"
                Margin="5,2" Padding="12,8" CornerRadius="8"
                Click="EmulatorBtn_Click"/>
      </StackPanel>
    </Border>

    <Border Grid.Column="1" Margin="20">
      <StackPanel x:Name="InterfacePanel">
        <TextBlock Text="Interface Settings" Foreground="White"
                   FontSize="22" FontWeight="Bold" Margin="0,0,0,20"/>
        <Border Background="#111118" CornerRadius="10" Padding="20" Margin="0,0,0,10">
          <StackPanel>
            <TextBlock Text="Theme" Foreground="#888888" FontSize="12" Margin="0,0,0,5"/>
            <ComboBox Width="200" HorizontalAlignment="Left">
              <ComboBoxItem Content="Dark (Default)"/>
              <ComboBoxItem Content="Light"/>
              <ComboBoxItem Content="Nintendo Red"/>
            </ComboBox>
          </StackPanel>
        </Border>
        <Border Background="#111118" CornerRadius="10" Padding="20" Margin="0,0,0,10">
          <StackPanel>
            <TextBlock Text="Language" Foreground="#888888" FontSize="12" Margin="0,0,0,5"/>
            <ComboBox Width="200" HorizontalAlignment="Left">
              <ComboBoxItem Content="English"/>
              <ComboBoxItem Content="Japanese"/>
              <ComboBoxItem Content="French"/>
            </ComboBox>
          </StackPanel>
        </Border>
        <Border Background="#111118" CornerRadius="10" Padding="20">
          <CheckBox Content="Show game list on startup"
                    Foreground="White" IsChecked="True"/>
        </Border>
      </StackPanel>
    </Border>

  </Grid>

</Window>